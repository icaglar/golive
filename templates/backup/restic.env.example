# golive: restic for uploads/volumes and the server's .env (encrypted client-side, offsite at ANOTHER provider/account).
# Copy to /etc/golive/restic.env (chmod 0600, root), fill in on the server. Never commit. Back up the repository
# password in the owner's password manager: without it the repository cannot be opened (the .env backup holds
# every generated secret of the app, so this is the recovery path after losing the server).
# Initialise once: set -a; . /etc/golive/restic.env; set +a; restic init
RESTIC_REPOSITORY=s3:__S3_ENDPOINT__/__RESTIC_BUCKET__/__PROJECT__
RESTIC_PASSWORD_FILE=/etc/golive/restic.pass
AWS_ACCESS_KEY_ID=__S3_KEY__
AWS_SECRET_ACCESS_KEY=__S3_KEY_SECRET__
# What to back up (space separated); docker volumes live under /var/lib/docker/volumes/<project>_<name>/_data
RESTIC_PATHS="/srv/app/.env /srv/app/uploads"
# golive-backup.sh picks this file up via: RESTIC_ENV_FILE=/etc/golive/restic.env (set in golive-backup.service)
# Restore: restic restore latest --target /restore --tag golive ; verify with `restic check` monthly.
